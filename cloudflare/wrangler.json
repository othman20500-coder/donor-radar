{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "donor-radar-unconfigured",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "donor-radar-v13-dev",
      "compatibility_flags": ["nodejs_compat"],
      "account_id": "bcbed680096d1c5580a98fe78685a5b8",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "dist/assets",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "none"
      },
      "vars": {
        "APP_ENV": "development",
        "APP_NAME": "donor-radar-v13-dev",
        "PUBLIC_URL": "https://donor-radar-v13-dev.othman20500.workers.dev",
        "LIVE_SCAN_ENABLED": "true",
        "REVIEWED_SOURCE_URLS": "[\"https://www.gov.uk/guidance/find-government-grants\",\"https://asf.gov.sa/ar/services/*\",\"https://almonasib.sa/%D8%B5%D9%81%D8%AD%D8%A9-%D8%A5%D8%B9%D9%84%D8%A7%D9%86%D8%A7%D8%AA-%D8%A7%D9%84%D8%AC%D9%87%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%A7%D9%86%D8%AD%D8%A9/*\"]"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "donor-radar-v13-dev",
          "database_id": "f7665d9e-7921-49d4-ab6d-076f0c67726c",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BACKUPS",
          "bucket_name": "donor-radar-v13-dev-backups"
        }
      ],
      "triggers": {
        "crons": [
          "0 * * * *",
          "30 * * * *"
        ]
      }
    }
  }
}
