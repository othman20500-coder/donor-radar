{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "donor-radar-unconfigured",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "donor-radar-v13-dev",
      "account_id": "bcbed680096d1c5580a98fe78685a5b8",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "dist/assets",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "none"
      },
      "vars": {
        "APP_ENV": "development",
        "APP_NAME": "donor-radar-v13-dev",
        "PUBLIC_URL": "https://donor-radar-v13-dev.othman20500.workers.dev",
        "LIVE_SCAN_ENABLED": "false",
        "REVIEWED_SOURCE_URLS": "[]"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "donor-radar-v13-dev",
          "database_id": "f7665d9e-7921-49d4-ab6d-076f0c67726c",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
